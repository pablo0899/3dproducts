---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Destello from '../components/Destello.astro';
import { SITIO } from '../config';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}

const { titulo, descripcion = SITIO.descripcion, imagen } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITIO.nombre}` : `${SITIO.nombre} · ${SITIO.descriptor}`;
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3a243b" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {imagen && <meta property="og:image" content={new URL(imagen, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap"
    />
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <Logo />
        <nav>
          <a href="/#catalogo">Productos</a>
          <a href="#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer id="contacto" class="pie seccion-oscura">
      <div class="contenedor pie__fila">
        <Destello tamano={28} />
        <p class="pie__cierre">{SITIO.cierre}</p>
        <p class="pie__texto">
          ¿Tienes una idea, un recuerdo o un personaje que quieras tener en tus manos? Cuéntanos y lo hacemos real.
        </p>
        <div class="pie__enlaces">
          <a href={`https://wa.me/${SITIO.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={SITIO.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={`mailto:${SITIO.email}`}>{SITIO.email}</a>
        </div>
        <div class="pie__firma">
          <Logo claro />
          <small>{SITIO.descriptor} · © {anio}</small>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(253 251 247 / 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-borde);
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }
  nav { display: flex; gap: 22px; }
  nav a {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-suave);
  }
  nav a:hover { color: var(--berry-magenta); }

  .pie { margin-top: 96px; padding-block: 64px 40px; }
  .pie__fila { display: grid; gap: 18px; justify-items: start; }
  .pie__cierre {
    margin: 0;
    max-width: 18ch;
    font-family: var(--fuente-display);
    font-style: italic;
    font-size: clamp(1.8rem, 7vw, 2.8rem);
    line-height: 1.15;
  }
  .pie__texto { margin: 0; max-width: 46ch; color: rgb(253 251 247 / 0.75); }
  .pie__enlaces { display: flex; flex-wrap: wrap; gap: 10px 24px; font-weight: 500; }
  .pie__enlaces a { color: var(--soft-rose); text-decoration: none; }
  .pie__enlaces a:hover { color: var(--burnt-orange); }
  .pie__firma {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    width: 100%;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid rgb(244 182 194 / 0.2);
    color: rgb(253 251 247 / 0.6);
    font-size: 0.8rem;
  }

  @media (max-width: 400px) {
    nav { gap: 14px; }
    nav a { letter-spacing: 0.12em; }
  }
  @media (max-width: 340px) {
    nav a:first-child { display: none; }
  }
</style>
