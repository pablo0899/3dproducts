---
import type { CollectionEntry } from 'astro:content';
import { formatearPrecio } from '../utils';

interface Props {
  producto: CollectionEntry<'productos'>;
}

const { producto } = Astro.props;
const { nombre, resumen, fotos, precio, categoria, modelo, disponible } = producto.data;
---

<a href={`/productos/${producto.id}/`} class="tarjeta" data-categoria={categoria}>
  <div class="tarjeta__imagen">
    <img src={fotos[0]} alt={nombre} loading="lazy" width="600" height="600" />
    {modelo && <span class="tarjeta__badge">360°</span>}
    {!disponible && <span class="tarjeta__agotado">Agotado</span>}
  </div>
  <div class="tarjeta__cuerpo">
    <span class="etiqueta">{categoria}</span>
    <h3>{nombre}</h3>
    <p>{resumen}</p>
    <strong class="tarjeta__precio">{formatearPrecio(precio)}</strong>
  </div>
</a>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .tarjeta:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgb(58 36 59 / 0.14); }
  .tarjeta__imagen { position: relative; aspect-ratio: 1; background: var(--plum-night); }
  .tarjeta__imagen img { width: 100%; height: 100%; object-fit: cover; }
  .tarjeta__badge, .tarjeta__agotado {
    position: absolute;
    top: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tarjeta__badge { right: 10px; background: var(--ivory-dust); color: var(--plum-night); }
  .tarjeta__agotado { left: 10px; background: rgb(58 36 59 / 0.85); color: var(--soft-rose); }
  .tarjeta__cuerpo { display: grid; gap: 6px; padding: 16px 16px 20px; justify-items: start; }
  h3 { margin: 2px 0 0; font-size: 1.2rem; }
  p { margin: 0; color: var(--color-suave); font-size: 0.88rem; }
  .tarjeta__precio { margin-top: 6px; color: var(--terracotta); font-size: 1rem; font-weight: 600; }
</style>
