---
import type { CollectionEntry } from 'astro:content';
import { formatearPrecio } from '../utils';

interface Props {
  producto: CollectionEntry<'productos'>;
}

const { producto } = Astro.props;
const { nombre, resumen, fotos, precio, categoria, modelo, disponible } = producto.data;
---

<a href={`/productos/${producto.id}/`} class="tarjeta" data-categoria={categoria}>
  <div class="tarjeta__imagen">
    {fotos.map((foto, i) => (
      <img
        src={foto}
        alt={i === 0 ? nombre : ''}
        loading="lazy"
        decoding="async"
        width="600"
        height="750"
        class={i === 0 ? 'activa' : undefined}
      />
    ))}
    {fotos.length > 1 && (
      <span class="tarjeta__puntos" aria-hidden="true">
        {fotos.map((_, i) => <span class={i === 0 ? 'activa' : undefined}></span>)}
      </span>
    )}
    {modelo && <span class="tarjeta__badge">360°</span>}
    {!disponible && <span class="tarjeta__agotado">Agotado</span>}
  </div>
  <div class="tarjeta__cuerpo">
    <span class="etiqueta">{categoria}</span>
    <h3>{nombre}</h3>
    <p>{resumen}</p>
    <strong class="tarjeta__precio">{formatearPrecio(precio)}</strong>
  </div>
</a>

<script>
  // Con varias fotos, la tarjeta las va pasando con un fundido mientras está en pantalla.
  const INTERVALO = 3500;
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tarjetas = [...document.querySelectorAll<HTMLElement>('.tarjeta__imagen')].filter(
    (t) => t.querySelectorAll('img').length > 1,
  );

  if (!sinMovimiento && tarjetas.length > 0) {
    const visibles = new Set<HTMLElement>();
    const observador = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        const tarjeta = e.target as HTMLElement;
        if (e.isIntersecting) visibles.add(tarjeta);
        else visibles.delete(tarjeta);
      });
    }, { threshold: 0.6 });
    tarjetas.forEach((t) => observador.observe(t));

    const avanzar = (tarjeta: HTMLElement) => {
      // Las ocultas por el filtro de líneas no cuentan.
      if (!visibles.has(tarjeta) || document.hidden || tarjeta.closest('[hidden]')) return;
      const fotos = tarjeta.querySelectorAll('img');
      const puntos = tarjeta.querySelectorAll('.tarjeta__puntos span');
      const actual = [...fotos].findIndex((f) => f.classList.contains('activa'));
      const siguiente = (actual + 1) % fotos.length;
      // Si la siguiente aún no carga, se pide ya y se cambia en la próxima vuelta.
      if (!fotos[siguiente].complete) {
        fotos[siguiente].loading = 'eager';
        return;
      }
      fotos[actual].classList.remove('activa');
      puntos[actual]?.classList.remove('activa');
      fotos[siguiente].classList.add('activa');
      puntos[siguiente]?.classList.add('activa');
    };

    // Cada tarjeta arranca desfasada para que no cambien todas al mismo tiempo.
    tarjetas.forEach((tarjeta, i) => {
      window.setTimeout(() => {
        window.setInterval(() => avanzar(tarjeta), INTERVALO);
      }, (i * 900) % INTERVALO);
    });
  }
</script>

<style>
  /* Editorial: la imagen lleva el marco y el texto va directo sobre el fondo */
  .tarjeta { display: flex; flex-direction: column; gap: 14px; color: inherit; text-decoration: none; }
  .tarjeta__imagen {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--plum-night);
  }
  .tarjeta__imagen img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s ease, scale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tarjeta__imagen img.activa { opacity: 1; }
  .tarjeta:hover .tarjeta__imagen img { scale: 1.04; }
  .tarjeta__puntos {
    position: absolute;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    display: flex;
    gap: 5px;
    padding: 5px 7px;
    border-radius: 999px;
    background: rgb(58 36 59 / 0.45);
  }
  .tarjeta__puntos span {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgb(253 251 247 / 0.5);
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .tarjeta__puntos span.activa { width: 14px; background: var(--ivory-dust); }
  .tarjeta__badge, .tarjeta__agotado {
    position: absolute;
    top: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tarjeta__badge { right: 10px; background: rgb(253 251 247 / 0.92); color: var(--plum-night); }
  .tarjeta__agotado { left: 10px; background: rgb(58 36 59 / 0.85); color: var(--soft-rose); }
  .tarjeta__cuerpo { display: grid; gap: 4px; justify-items: start; }
  .etiqueta { font-size: 0.6rem; }
  h3 { margin: 2px 0 0; font-size: 1.12rem; line-height: 1.2; }
  .tarjeta:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--color-suave);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .tarjeta__precio { margin-top: 4px; color: var(--terracotta); font-size: 0.95rem; font-weight: 600; font-variant-numeric: tabular-nums; }

  @media (min-width: 768px) {
    h3 { font-size: 1.3rem; }
    p { font-size: 0.88rem; }
    .etiqueta { font-size: 0.66rem; }
  }
</style>
