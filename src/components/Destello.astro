---
// Destello de cuatro puntas: elemento gráfico de la marca.
interface Props {
  tamano?: number;
  class?: string;
}

const { tamano = 24, class: clase } = Astro.props;
const id = `destello-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={clase} width={tamano} height={tamano} viewBox="0 0 24 24" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f4b6c2" />
      <stop offset=".5" stop-color="#e07a5f" />
      <stop offset="1" stop-color="#d83a6b" />
    </linearGradient>
  </defs>
  <path d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12C6.4 11.4 11.4 6.4 12 0z" fill={`url(#${id})`} />
</svg>
