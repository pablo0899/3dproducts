---
// Iconografía neón de la marca (trazo de línea).
interface Props {
  nombre: 'mascota' | 'figura' | 'estadio' | 'souvenir' | 'dado';
  tamano?: number;
}

const { nombre, tamano = 48 } = Astro.props;
---

<svg width={tamano} height={tamano} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'mascota' && (
    <>
      <path d="M14 14c-4-2-8 2-7 8 1 4 4 5 6 3" />
      <path d="M34 14c4-2 8 2 7 8-1 4-4 5-6 3" />
      <path d="M13 22c0-7 5-11 11-11s11 4 11 11v5c0 7-5 11-11 11s-11-4-11-11z" />
      <circle cx="19" cy="23" r="1.2" fill="currentColor" />
      <circle cx="29" cy="23" r="1.2" fill="currentColor" />
      <path d="M22 29h4l-2 2z" />
      <path d="M17 38c2 2 5 3 7 3s5-1 7-3" />
      <circle cx="24" cy="43" r="1.6" />
    </>
  )}
  {nombre === 'figura' && (
    <>
      <circle cx="24" cy="14" r="7" />
      <path d="M12 36c0-8 5-13 12-13s12 5 12 13" />
      <path d="M10 36h28v4H10z" />
      <path d="M14 40v4h20v-4" />
    </>
  )}
  {nombre === 'estadio' && (
    <>
      <ellipse cx="24" cy="28" rx="19" ry="9" />
      <ellipse cx="24" cy="28" rx="11" ry="4.5" />
      <path d="M5 28v6c0 5 9 9 19 9s19-4 19-9v-6" />
      <path d="M10 21V9l5 2-5 2" />
      <path d="M38 21V9l5 2-5 2" />
      <path d="M24 19V7l5 2-5 2" />
    </>
  )}
  {nombre === 'souvenir' && (
    <>
      <path d="M16 6l-8 5 3 6 4-2v14h14V15l4 2 3-6-8-5c-1 3-3 4-6 4s-5-1-6-4z" />
      <path d="M6 40l3-7h22l3 7" />
      <path d="M4 40h36v3H4z" />
      <circle cx="12" cy="43" r="2.5" />
      <circle cx="32" cy="43" r="2.5" />
      <path d="M40 18v6c2 1 2 3 2 5v14h-6V29c0-2 0-4 2-5v-6z" />
    </>
  )}
  {nombre === 'dado' && (
    <>
      <path d="M24 3l19 11v20L24 45 5 34V14z" />
      <path d="M24 3l-10 20h20z" />
      <path d="M14 23L5 14M34 23l9-9M14 23l10 22 10-22M14 23L5 34M34 23l9 11" />
      <text x="24" y="19.5" fill="currentColor" stroke="none" font-size="7" font-weight="700" text-anchor="middle" font-family="Montserrat, sans-serif">20</text>
    </>
  )}
</svg>
