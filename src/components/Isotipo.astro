---
// Isotipo de Prismatika: prisma facetado envuelto por una cinta magenta.
interface Props {
  tamano?: number;
}

const { tamano = 36 } = Astro.props;
---

<svg class="isotipo" width={tamano} height={tamano} viewBox="0 0 64 64" aria-hidden="true">
  <g transform="rotate(-18 32 36)">
    <path d="M4 36a28 9 0 0 1 56 0" fill="none" stroke="#ff2e93" stroke-width="3.5" stroke-linecap="round" opacity=".45" />
  </g>
  <path d="M32 4 12 36l20 24z" fill="#5a3d4a" />
  <path d="M32 4l20 32-20 24z" fill="#c25e38" />
  <path d="M32 4 12 36l18 4z" fill="#f4b6c2" />
  <path d="M32 4l20 32-22 4z" fill="#e07a5f" />
  <path d="M12 36l18 4 2 20z" fill="#3b2f3c" />
  <path d="M52 36l-22 4 2 20z" fill="#8c3f3a" />
  <g transform="rotate(-18 32 36)">
    <path d="M60 36a28 9 0 0 1-56 0" fill="none" stroke="#ff2e93" stroke-width="4" stroke-linecap="round" />
  </g>
</svg>

<style>
  .isotipo { flex: none; filter: drop-shadow(0 0 6px rgb(255 46 147 / 0.5)); }
</style>
