---
// Logotipo: PRISMATIX en serif con la "A" en degradado de atardecer.
interface Props {
  claro?: boolean; // true sobre fondos oscuros
}

const { claro = false } = Astro.props;
---

<a href="/" class:list={['logo', { 'logo--claro': claro }]} aria-label="Prismatix, inicio">
  PRISM<span class="logo__a">A</span>TIX
</a>

<style>
  .logo {
    font-family: var(--fuente-display);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--plum-night);
    text-decoration: none;
  }
  .logo--claro { color: var(--ivory-dust); }
  .logo__a {
    background: linear-gradient(180deg, var(--berry-magenta), var(--burnt-orange) 70%, var(--soft-rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (max-width: 400px) {
    .logo { font-size: 1.15rem; letter-spacing: 0.06em; }
  }
</style>
