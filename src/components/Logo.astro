---
// Logotipo: isotipo (cinta) + PRISMATIX en serif con la "A" en degradado.
interface Props {
  claro?: boolean; // true sobre fondos oscuros
}

const { claro = false } = Astro.props;
---

<a href="/" class:list={['logo', { 'logo--claro': claro }]} aria-label="Prismatix, inicio">
  <img class="logo__isotipo" src="/marca/isotipo-96.webp" alt="" width="96" height="96" />
  <span>PRISM<span class="logo__a">A</span>TIX</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--fuente-display);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--plum-night);
    text-decoration: none;
  }
  .logo--claro { color: var(--ivory-dust); }
  .logo__isotipo { width: 34px; height: 34px; flex: none; }
  .logo__a {
    background: linear-gradient(180deg, var(--berry-magenta), var(--burnt-orange) 70%, var(--soft-rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (max-width: 400px) {
    .logo { gap: 8px; font-size: 1.12rem; letter-spacing: 0.06em; }
    .logo__isotipo { width: 28px; height: 28px; }
  }
</style>
