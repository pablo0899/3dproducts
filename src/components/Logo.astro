---
// Logotipo: isotipo (cinta) + PRISMΛTIX en sans (Montserrat). "PRISM" va en
// grosor regular y "TIX" en delgado; la "A" es una lambda mayúscula (Λ) en
// degradado, dibujada en SVG con la pierna izquierda regular y la derecha delgada.
interface Props {
  claro?: boolean; // true sobre fondos oscuros
}

const { claro = false } = Astro.props;
const idDegradado = claro ? 'logo-degradado-claro' : 'logo-degradado';
---

<a href="/" class:list={['logo', { 'logo--claro': claro }]} aria-label="Prismatix, inicio">
  <img class="logo__isotipo" src="/marca/isotipo-96.webp" alt="" width="96" height="96" />
  <span class="logo__texto" aria-hidden="true">
    <span class="logo__regular">PRISM</span><svg class="logo__lambda" viewBox="0 0 90 100" aria-hidden="true">
      <defs>
        <linearGradient id={idDegradado} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#D83A6B" />
          <stop offset="0.7" stop-color="#E07A5F" />
          <stop offset="1" stop-color="#F4B6C2" />
        </linearGradient>
      </defs>
      <polygon points="0,100 41,0 49,0 90,100 84,100 50,17 16,100" fill={`url(#${idDegradado})`} />
    </svg><span class="logo__delgado">TIX</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--fuente);
    font-size: 1.2rem;
    letter-spacing: 0.16em;
    line-height: 1;
    color: var(--plum-night);
    text-decoration: none;
  }
  .logo--claro { color: var(--ivory-dust); }
  .logo__isotipo { width: 34px; height: 34px; flex: none; }
  .logo__texto { display: inline-flex; align-items: baseline; white-space: nowrap; }
  .logo__regular { font-weight: 400; }
  .logo__delgado { font-weight: 200; }
  /* Mide lo mismo que una mayúscula de Montserrat (~0.7em) */
  .logo__lambda {
    width: 0.63em;
    height: 0.7em;
    margin-right: 0.16em;
    flex: none;
  }
  @media (max-width: 400px) {
    .logo { gap: 8px; font-size: 1rem; letter-spacing: 0.12em; }
    .logo__isotipo { width: 28px; height: 28px; }
    .logo__lambda { margin-right: 0.12em; }
  }
</style>
