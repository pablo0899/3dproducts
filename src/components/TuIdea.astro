---
// Sección "Dale forma a tu idea" (#tu-idea): destino de todos los llamados a la acción.
// No hay backend: el formulario arma el mensaje con lo que escribió la persona y lo manda
// por el canal elegido. Prioridad: WhatsApp (si hay número), Instagram, Facebook y el correo al final.
import Icono from './Icono.astro';
import { SITIO, CATEGORIAS } from '../config';
import { canales, atributosCanal } from '../utils';
import { getCollection } from 'astro:content';

const lista = canales('Quiero una pieza Prismatix', 'Hola, Prismatix. Tengo una idea y me gustaría hacerla realidad con ustedes.');
const redes = lista.filter((c) => c.id !== 'correo');
const correo = lista.find((c) => c.id === 'correo')!;

// El selector solo ofrece las líneas que ya tienen productos visibles
const productos = await getCollection('productos', (p) => !p.data.oculto);
const lineas = CATEGORIAS.filter((c) => productos.some((p) => p.data.categoria === c.nombre));

const pasos = [
  { titulo: 'Cuéntanos tu idea', texto: 'Qué te imaginas, para quién es y, si tienes, fotos de referencia.' },
  { titulo: 'Te enviamos una propuesta', texto: 'Con el diseño, una vista previa, el precio y el tiempo de entrega de tu pieza.' },
  { titulo: 'La hacemos real', texto: 'Cuando la apruebas, comenzamos. Te avisamos en cuanto esté lista.' },
];
---

<section id="tu-idea" class="agenda" aria-labelledby="titulo-agenda">
  <div class="contenedor agenda__rejilla">
    <div class="agenda__intro">
      <p class="titulo-seccion">Dale forma a tu idea</p>
      <h2 id="titulo-agenda">Tú la imaginas, <em>nosotros la hacemos real.</em></h2>
      <ol class="pasos">
        {pasos.map((p, i) => (
          <li>
            <span class="pasos__numero">{i + 1}</span>
            <div>
              <strong>{p.titulo}</strong>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="agenda__directo">
        <p>¿Prefieres escribir directo?</p>
        <ul>
          {redes.map((c) => (
            <li>
              <a {...atributosCanal(c)}>
                {c.id !== 'correo' && <Icono nombre={c.id} tamano={22} />}
                {c.id === 'instagram' ? 'Mándanos un DM en Instagram' : `Escríbenos por ${c.nombre}`}
              </a>
            </li>
          ))}
        </ul>
        <p class="agenda__correo">O por correo: <a {...atributosCanal(correo)}>{SITIO.email}</a></p>
      </div>
    </div>

    <form class="formulario" data-email={SITIO.email}>
      <label>
        <span>Tu nombre</span>
        <input name="nombre" type="text" autocomplete="name" required />
      </label>
      <label>
        <span>¿Qué te gustaría crear?</span>
        <select name="linea">
          {lineas.map((c) => <option>{c.nombre}</option>)}
          <option selected>Otra idea</option>
        </select>
      </label>
      <label>
        <span>Cuéntanos tu idea</span>
        <textarea name="idea" rows="4" required placeholder="Ej. Una figura de mi perro Coco para regalarle a mi mamá en su cumpleaños."></textarea>
      </label>
      <div class="formulario__fila">
        <label>
          <span>¿Para cuándo?</span>
          <input name="fecha" type="date" />
        </label>
        <label>
          <span>Tu teléfono <small>(opcional)</small></span>
          <input name="telefono" type="tel" autocomplete="tel" inputmode="tel" />
        </label>
      </div>
      <div class="formulario__acciones">
        {lista.map((c, i) => (
          <button
            type="submit"
            class:list={[c.id === 'correo' ? 'formulario__correo' : 'boton', { 'boton--secundario': i > 0 && c.id !== 'correo' }]}
            data-canal={c.id}
            data-nombre={c.nombre}
            data-url={c.id === 'whatsapp' ? `https://wa.me/${SITIO.whatsapp}` : c.url}
          >
            {c.id !== 'correo' && <Icono nombre={c.id} tamano={20} />}
            {c.id === 'correo' ? 'Prefiero enviarlo por correo' : `Enviar por ${c.nombre}`}
          </button>
        ))}
      </div>
      <p class="formulario__nota">
        {lista[0].id === 'whatsapp'
          ? 'Se abrirá WhatsApp con tu mensaje listo. Solo tienes que enviarlo.'
          : lista[0].id === 'instagram' || lista[0].id === 'facebook'
            ? 'Copiamos tu mensaje y abrimos el chat: solo pégalo y envíalo.'
            : 'Se abrirá tu app de correo con el mensaje listo. Solo tienes que enviarlo.'}
      </p>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('.formulario').forEach((form) => {
    const botones = form.querySelectorAll<HTMLButtonElement>('[data-canal]');
    let elegido = botones[0];
    botones.forEach((b) => b.addEventListener('click', () => (elegido = b)));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const valor = (k: string) => String(d.get(k) ?? '').trim();
      const fecha = valor('fecha')
        ? new Date(valor('fecha') + 'T12:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })
        : 'Sin fecha definida';
      const mensaje = [
        `Hola, Prismatix. Soy ${valor('nombre')}.`,
        '',
        `Me gustaría crear: ${valor('linea')}`,
        `Mi idea: ${valor('idea')}`,
        `Para cuándo: ${fecha}`,
        valor('telefono') ? `Mi teléfono: ${valor('telefono')}` : '',
      ].filter((l, i, a) => l !== '' || a[i - 1] !== '').join('\n');

      const { canal, nombre, url } = elegido.dataset;
      if (canal === 'correo') {
        const asunto = `Nueva idea: ${valor('linea')} · ${valor('nombre')}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(mensaje)}`;
      } else if (canal === 'whatsapp') {
        window.open(`${url}?text=${encodeURIComponent(mensaje)}`, '_blank');
      } else {
        // Instagram y Facebook: se copia el mensaje (aviso en Base.astro) y se abre el chat
        document.dispatchEvent(new CustomEvent('copiar-mensaje', { detail: { mensaje, canal: nombre } }));
        window.open(url, '_blank');
      }
    });
  });
</script>

<style>
  .agenda {
    scroll-margin-top: 64px;
    padding-block: 72px;
    background: var(--color-tinte);
  }
  .agenda__rejilla { display: grid; gap: 40px; }
  .agenda__intro { display: grid; gap: 20px; align-content: start; }
  .agenda .titulo-seccion { margin: 0; color: var(--berry-magenta); }
  h2 { margin: 0; max-width: 14ch; font-size: clamp(2rem, 7vw, 3.25rem); }
  h2 em { color: var(--terracotta); }

  .pasos { display: grid; gap: 0; margin: 8px 0 0; padding: 0; list-style: none; counter-reset: paso; }
  .pasos li { position: relative; padding-bottom: 22px; }
  /* Línea que une los pasos */
  .pasos li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 19.5px;
    top: 44px;
    bottom: 4px;
    width: 1px;
    background: rgb(58 36 59 / 0.2);
  }
  .pasos li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; }
  .pasos__numero {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--plum-night);
    color: var(--ivory-dust);
    font-family: var(--fuente-display);
    font-size: 1.1rem;
  }
  .pasos strong { font-weight: 600; }
  .pasos p { margin: 2px 0 0; color: var(--color-suave); font-size: 0.92rem; }

  .agenda__directo { display: grid; gap: 6px; margin-top: 8px; color: var(--color-suave); font-size: 0.92rem; }
  .agenda__directo p { margin: 0; }
  .agenda__directo ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .agenda__directo li a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--plum-night);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(58 36 59 / 0.25);
    text-underline-offset: 5px;
  }
  .agenda__directo li a :global(svg) { color: var(--berry-magenta); }
  .agenda__directo li a:hover { color: var(--berry-magenta); }
  .agenda__correo a { color: inherit; overflow-wrap: anywhere; }
  .agenda__correo a:hover { color: var(--berry-magenta); }

  .formulario {
    display: grid;
    gap: 16px;
    padding: 24px 20px;
    border-radius: var(--radio-grande);
    background: var(--color-superficie);
    box-shadow: var(--sombra);
  }
  label { display: grid; gap: 6px; }
  label span { font-size: 0.86rem; font-weight: 500; color: var(--plum-night); }
  label small { font-weight: 400; color: var(--color-suave); }
  input, select, textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid rgb(58 36 59 / 0.18);
    border-radius: 10px;
    background: var(--ivory-dust);
    color: var(--color-texto);
    font: inherit;
    font-size: 1rem; /* 16px: evita el zoom automático en iPhone */
  }
  textarea { resize: vertical; min-height: 110px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--berry-magenta); outline-offset: 1px; border-color: transparent; }
  .formulario__fila { display: grid; gap: 16px; }
  .formulario__acciones { display: grid; gap: 10px; margin-top: 4px; }
  .formulario__acciones .boton { width: 100%; }
  .formulario__correo {
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--color-suave);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .formulario__correo:hover { color: var(--berry-magenta); }
  .formulario__nota { margin: 0; color: var(--color-suave); font-size: 0.8rem; text-align: center; }

  @media (min-width: 560px) {
    .formulario__fila { grid-template-columns: 1fr 1fr; }
    .formulario { padding: 32px; }
  }
  @media (min-width: 900px) {
    .agenda { padding-block: 112px; }
    .formulario { padding: 40px; }
    .agenda__rejilla { grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }
  }
</style>
