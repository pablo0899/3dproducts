---
// Llamado a la acción que se repite entre secciones. El botón principal abre el primer
// canal (WhatsApp); después vienen los demás y el correo al final.
import Destello from './Destello.astro';
import Icono from './Icono.astro';
import { canales, atributosCanal } from '../utils';

interface Props {
  titulo: string;
  texto?: string;
  asunto?: string; // asunto del correo
  mensaje?: string; // mensaje que se copia (Instagram/Facebook) o se prellena (correo/WhatsApp)
}

const {
  titulo,
  texto,
  asunto = 'Quiero una pieza Prismatix',
  mensaje = 'Hola, Prismatix. Tengo una idea y me gustaría hacerla realidad con ustedes.',
} = Astro.props;
const [principal, ...otros] = canales(asunto, mensaje);
---

<aside class="llamado">
  <Destello tamano={22} class="llamado__destello" />
  <div class="llamado__texto">
    <p class="llamado__titulo">{titulo}</p>
    {texto && <p class="llamado__sub">{texto}</p>}
  </div>
  <div class="llamado__acciones">
    <a class="boton" {...atributosCanal(principal)}>
      {(principal.id === 'instagram' || principal.id === 'facebook') && <Icono nombre={principal.id} tamano={20} />}
      Escríbenos por {principal.nombre}
    </a>
    {otros.length > 0 && (
      <p class="llamado__otros">
        O por{' '}
        {otros.map((c, i) => (
          <>
            {i > 0 && (i === otros.length - 1 ? ' o ' : ', ')}
            <a {...atributosCanal(c)}>{c.nombre}</a>
          </>
        ))}
      </p>
    )}
  </div>
</aside>

<style>
  .llamado {
    position: relative;
    display: grid;
    gap: 18px;
    margin-block: 40px;
    padding: 28px 22px;
    border-radius: var(--radio);
    background: var(--fondo-terciopelo);
    color: var(--ivory-dust);
    overflow: hidden;
  }
  :global(.llamado__destello) { position: absolute; top: 18px; right: 18px; }
  .llamado__texto { display: grid; gap: 6px; padding-right: 28px; }
  .llamado__titulo {
    margin: 0;
    font-family: var(--fuente-display);
    font-style: italic;
    font-size: clamp(1.4rem, 5.5vw, 1.9rem);
    line-height: 1.2;
  }
  .llamado__sub { margin: 0; color: rgb(253 251 247 / 0.75); font-size: 0.92rem; }
  .llamado__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .llamado__otros { margin: 0; color: rgb(253 251 247 / 0.7); font-size: 0.86rem; }
  .llamado__otros a {
    color: var(--soft-rose);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgb(244 182 194 / 0.4);
  }
  .llamado__otros a:hover { color: var(--burnt-orange); }

  @media (min-width: 768px) {
    .llamado { grid-template-columns: 1fr auto; align-items: center; padding: 32px 40px; }
    .llamado__acciones { flex-direction: column; align-items: flex-end; gap: 10px; }
  }
</style>
