---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Galeria from '../../components/Galeria.astro';
import Visor3D from '../../components/Visor3D.astro';
import Llamado from '../../components/Llamado.astro';
import Icono from '../../components/Icono.astro';
import { formatearPrecio, canales, atributosCanal } from '../../utils';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((producto) => ({ params: { id: producto.id }, props: { producto } }));
}

const { producto } = Astro.props;
const { nombre, resumen, fotos, modelo, precio, categoria, material, dimensiones, colores, disponible } = producto.data;
const { Content } = await render(producto);
const mensaje = `Hola, Prismatix. Me interesa "${nombre}" (${Astro.url.href}).\n\n¿Me pueden dar más información?`;
// Instagram primero, luego Facebook y al final el correo
const [principal, ...otros] = canales(`Me interesa: ${nombre}`, mensaje);
const correo = otros.find((c) => c.id === 'correo');
const redes = otros.filter((c) => c.id !== 'correo');
---

<Base titulo={nombre} descripcion={resumen} imagen={fotos[0]}>
  <article class="contenedor producto">
    <nav class="ruta" aria-label="Ruta">
      <a href="/#catalogo">Colección</a>
      <span aria-hidden="true">/</span>
      <a href={`/?linea=${encodeURIComponent(categoria)}#catalogo`}>{categoria}</a>
    </nav>

    <div class="producto__medios">
      {modelo && (
        <div class="pestanas" role="tablist">
          <button type="button" role="tab" aria-selected="true" data-panel="fotos">Fotos</button>
          <button type="button" role="tab" aria-selected="false" data-panel="3d">Vista 360°</button>
        </div>
      )}
      <div data-contenido="fotos">
        <Galeria fotos={fotos} nombre={nombre} />
      </div>
      {modelo && (
        <div data-contenido="3d" hidden>
          <Visor3D modelo={modelo} nombre={nombre} poster={fotos[0]} />
        </div>
      )}
    </div>

    <div class="producto__info">
      <h1>{nombre}</h1>
      <p class="precio">{formatearPrecio(precio)}</p>
      <p class="resumen">{resumen}</p>

      <dl class="ficha">
        {material && (<><dt>Material</dt><dd>{material}</dd></>)}
        {dimensiones && (<><dt>Medidas</dt><dd>{dimensiones}</dd></>)}
        {colores.length > 0 && (<><dt>Colores</dt><dd>{colores.join(', ')}</dd></>)}
        <dt>Estado</dt><dd>{disponible ? 'Disponible' : 'Agotado — bajo pedido'}</dd>
      </dl>

      <div class="pedir">
        <a class="boton" {...atributosCanal(principal)}>
          {(principal.id === 'instagram' || principal.id === 'facebook') && <Icono nombre={principal.id} tamano={20} />}
          Lo quiero · Escríbenos por {principal.nombre}
        </a>
        {redes.map((c) => (
          <a class="boton boton--secundario" {...atributosCanal(c)}>
            {c.id === 'facebook' && <Icono nombre="facebook" tamano={20} />}
            Escríbenos por {c.nombre}
          </a>
        ))}
        {correo && <p class="pedir__correo">¿Prefieres el correo? <a {...atributosCanal(correo)}>Escríbenos aquí</a></p>}
        <a class="pedir__personalizar" href="/#tu-idea">¿Lo quieres con tu toque? Personalízalo <span aria-hidden="true">→</span></a>
      </div>

      <div class="descripcion">
        <Content />
      </div>
    </div>
  </article>

  <div class="contenedor">
    <Llamado
      titulo="¿Te imaginas una versión solo tuya?"
      texto="Cambiamos colores, tamaños y detalles para que cuente tu historia."
      asunto={`Quiero personalizar: ${nombre}`}
      mensaje={`Hola, Prismatix. Quiero personalizar "${nombre}" (${Astro.url.href}).`}
    />
  </div>
</Base>

<script>
  const pestanas = document.querySelectorAll<HTMLButtonElement>('.pestanas button');
  pestanas.forEach((pestana) => {
    pestana.addEventListener('click', () => {
      pestanas.forEach((p) => p.setAttribute('aria-selected', String(p === pestana)));
      document.querySelectorAll<HTMLElement>('[data-contenido]').forEach((panel) => {
        panel.hidden = panel.dataset.contenido !== pestana.dataset.panel;
      });
    });
  });
</script>

<style>
  .producto { display: grid; gap: 24px; padding-top: 16px; }
  .ruta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; color: var(--color-suave); font-size: 0.86rem; }
  .ruta a { color: inherit; text-decoration: none; }
  .ruta a:hover { color: var(--berry-magenta); text-decoration: underline; text-underline-offset: 4px; }
  .ruta a:last-child { color: var(--plum-night); font-weight: 500; }

  .pestanas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    margin-bottom: 12px;
    border-radius: 999px;
    border: 1px solid var(--color-borde);
    background: var(--color-superficie);
  }
  .pestanas button {
    min-height: 40px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-suave);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .pestanas button[aria-selected='true'] { background: var(--plum-night); color: var(--ivory-dust); }

  .producto__info { display: grid; gap: 12px; align-content: start; justify-items: start; }
  h1 { margin: 0; font-size: clamp(2.25rem, 9vw, 3.5rem); line-height: 1.05; }
  .precio { margin: 0; font-size: 1.35rem; font-weight: 600; color: var(--terracotta); font-variant-numeric: tabular-nums; }
  .resumen { margin: 0; max-width: 46ch; font-family: var(--fuente-display); font-size: 1.2rem; line-height: 1.45; }

  .ficha {
    display: grid;
    grid-template-columns: auto 1fr;
    width: 100%;
    margin: 12px 0;
    border-top: 1px solid var(--color-borde);
  }
  dt, dd { padding-block: 12px; border-bottom: 1px solid var(--color-borde); }
  dt { padding-right: 24px; color: var(--color-suave); font-size: 0.86rem; }
  dd { margin: 0; font-weight: 500; text-align: right; }

  .pedir { display: grid; gap: 10px; width: 100%; }
  .pedir .boton { width: 100%; }
  .pedir__correo { justify-self: center; margin: 0; color: var(--color-suave); font-size: 0.88rem; }
  .pedir__correo a { color: inherit; font-weight: 500; text-underline-offset: 4px; }
  .pedir__correo a:hover { color: var(--berry-magenta); }
  .pedir__personalizar {
    justify-self: center;
    margin-top: 4px;
    color: var(--berry-magenta);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(216 58 107 / 0.35);
    text-underline-offset: 5px;
  }
  .descripcion { width: 100%; max-width: 60ch; margin-top: 16px; color: #4d3a4e; }
  .descripcion :global(ul) { padding-left: 1.2em; }
  .descripcion :global(li::marker) { color: var(--berry-magenta); }

  @media (min-width: 900px) {
    .producto { grid-template-columns: 1.1fr 1fr; gap: 32px 64px; padding-top: 32px; }
    .producto__medios { position: sticky; top: 80px; align-self: start; }
    .pedir { justify-items: start; }
    .pedir .boton { width: auto; }
    .pedir__personalizar, .pedir__correo { justify-self: start; }
  }
</style>
