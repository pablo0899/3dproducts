---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import Icono from '../components/Icono.astro';
import Destello from '../components/Destello.astro';
import { SITIO, CATEGORIAS, ESENCIA } from '../config';

const productos = (await getCollection('productos')).sort(
  (a, b) => Number(b.data.destacado) - Number(a.data.destacado) || a.data.orden - b.data.orden,
);
---

<Base>
  <section class="portada seccion-oscura">
    <!-- Luz prismática decorativa -->
    <div class="prisma" aria-hidden="true">
      <span class="prisma__haz prisma__haz--1"></span>
      <span class="prisma__haz prisma__haz--2"></span>
      <span class="prisma__haz prisma__haz--3"></span>
      <span class="prisma__cristal"></span>
      <span class="prisma__faceta"></span>
      <span class="prisma__orbita"></span>
      <Destello tamano={34} class="prisma__destello" />
    </div>

    <div class="contenedor portada__texto">
      <p class="titulo-seccion">{SITIO.descriptor}</p>
      <h1>{SITIO.eslogan}</h1>
      <p class="portada__sub">{SITIO.subtitulo}</p>
      <a href="#catalogo" class="boton">Descubre la colección</a>
    </div>
  </section>

  <section class="esencia contenedor" aria-labelledby="titulo-esencia">
    <h2 class="titulo-seccion" id="titulo-esencia">Esencia</h2>
    <p class="esencia__frase">
      Fusionamos arte y diseño para crear piezas que cuentan historias, despiertan emociones y se convierten en{' '}
      <em>recuerdos duraderos.</em>
    </p>
    <ul class="esencia__lista">
      {ESENCIA.map((e) => (
        <li>
          <Icono nombre={e.icono} tamano={30} />
          <span>{e.titulo}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="catalogo" class="contenedor catalogo">
    <h2 class="titulo-seccion">Explora por línea</h2>
    <div class="lineas" role="group" aria-label="Filtrar por línea de producto">
      {CATEGORIAS.map((c) => (
        <button type="button" class="linea" data-filtro={c.nombre} aria-pressed="false">
          <Icono nombre={c.icono} tamano={36} />
          <span>{c.nombre}</span>
        </button>
      ))}
    </div>

    <div class="catalogo__cabecera">
      <h2 id="titulo-rejilla">Toda la colección</h2>
      <button type="button" class="ver-todo" hidden>Ver todo ✕</button>
    </div>

    <div class="rejilla">
      {productos.map((producto) => <TarjetaProducto producto={producto} />)}
    </div>
    <p class="vacio" hidden>
      Muy pronto tendremos piezas en esta línea. ¿Quieres una a tu medida? <a href="#contacto">Escríbenos</a>.
    </p>
  </section>
</Base>

<script>
  const lineas = document.querySelectorAll<HTMLButtonElement>('.lineas button');
  const tarjetas = document.querySelectorAll<HTMLElement>('.rejilla [data-categoria]');
  const titulo = document.querySelector<HTMLElement>('#titulo-rejilla')!;
  const verTodo = document.querySelector<HTMLButtonElement>('.ver-todo')!;
  const vacio = document.querySelector<HTMLElement>('.vacio')!;

  function filtrar(filtro: string) {
    lineas.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === filtro)));
    let visibles = 0;
    tarjetas.forEach((t) => {
      t.hidden = !!filtro && t.dataset.categoria !== filtro;
      if (!t.hidden) visibles++;
    });
    titulo.textContent = filtro || 'Toda la colección';
    verTodo.hidden = !filtro;
    vacio.hidden = visibles > 0;
  }

  lineas.forEach((boton) => {
    boton.addEventListener('click', () => {
      const activo = boton.getAttribute('aria-pressed') === 'true';
      filtrar(activo ? '' : boton.dataset.filtro!);
    });
  });
  verTodo.addEventListener('click', () => filtrar(''));
</script>

<style>
  /* ── Portada ── */
  .portada {
    position: relative;
    overflow: hidden;
    padding-block: 64px 72px;
  }
  .portada__texto { position: relative; z-index: 1; display: grid; gap: 16px; justify-items: start; }
  .portada .titulo-seccion { margin: 0; }
  .portada h1 {
    margin: 0;
    max-width: 11ch;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.6rem, 12vw, 5rem);
    line-height: 1.05;
  }
  .portada__sub { margin: 0 0 8px; max-width: 40ch; color: rgb(253 251 247 / 0.78); }

  /* Prisma: cristal, haces de luz y órbita (solo CSS) */
  .prisma {
    position: absolute;
    top: 50%;
    right: -120px;
    width: 260px;
    height: 320px;
    transform: translateY(-50%);
    opacity: 0.35;
    pointer-events: none;
  }
  .prisma__haz {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 520px;
    height: 46px;
    border-radius: 50%;
    background: linear-gradient(90deg, transparent, rgb(244 182 194 / 0.7), rgb(224 122 95 / 0.6), transparent);
    filter: blur(14px);
    transform-origin: 0 50%;
  }
  .prisma__haz--1 { transform: rotate(160deg); }
  .prisma__haz--2 { transform: rotate(200deg); background: linear-gradient(90deg, transparent, rgb(216 58 107 / 0.7), transparent); }
  .prisma__haz--3 { transform: rotate(-20deg); height: 30px; }
  .prisma__cristal, .prisma__faceta {
    position: absolute;
    inset: 40px 50px;
    clip-path: polygon(50% 0, 100% 58%, 50% 100%, 0 58%);
  }
  .prisma__cristal { background: var(--degradado-prisma); box-shadow: 0 0 60px rgb(216 58 107 / 0.6); }
  .prisma__faceta {
    background: linear-gradient(200deg, rgb(253 251 247 / 0.55), transparent 45%, rgb(58 36 59 / 0.5));
    clip-path: polygon(50% 0, 100% 58%, 50% 100%);
  }
  .prisma__orbita {
    position: absolute;
    left: -10px;
    right: -10px;
    top: 52%;
    height: 90px;
    border: 1px solid rgb(244 182 194 / 0.6);
    border-radius: 50%;
    transform: rotate(-14deg);
  }
  :global(.prisma__destello) { position: absolute; top: 18px; left: 30px; display: none; }

  /* ── Esencia ── */
  .esencia { padding-block: 64px 24px; }
  .esencia__frase {
    margin: 0 0 32px;
    max-width: 30ch;
    font-family: var(--fuente-display);
    font-size: clamp(1.5rem, 5.5vw, 2.2rem);
    line-height: 1.3;
  }
  .esencia__frase em { color: var(--terracotta); }
  .esencia__lista {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .esencia__lista li { display: grid; justify-items: center; gap: 10px; text-align: center; color: var(--plum-night); }
  .esencia__lista span { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }

  /* ── Catálogo ── */
  .catalogo { padding-top: 56px; }
  .lineas {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    margin: 0 -16px 24px;
    padding: 4px 16px 12px;
    scrollbar-width: none;
  }
  .lineas::-webkit-scrollbar { display: none; }
  .linea {
    flex: 0 0 128px;
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 18px 10px 14px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    background: var(--color-superficie);
    color: var(--plum-night);
    font: inherit;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .linea svg { color: var(--deep-plum); }
  .linea:hover { border-color: var(--berry-magenta); }
  .linea[aria-pressed='true'] { background: var(--plum-night); border-color: var(--plum-night); color: var(--ivory-dust); }
  .linea[aria-pressed='true'] svg { color: var(--soft-rose); }

  .catalogo__cabecera { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .catalogo__cabecera h2 { margin: 0; font-size: clamp(1.6rem, 6vw, 2.2rem); }
  .ver-todo {
    min-height: 40px;
    border: 0;
    background: none;
    color: var(--berry-magenta);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .vacio { padding: 32px 0; color: var(--color-suave); }
  .vacio a { color: var(--berry-magenta); }

  /* 1 columna en móvil pequeño, 2 en móvil grande, 3-4 en escritorio */
  .rejilla { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 420px) { .rejilla { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
  @media (min-width: 600px) { .esencia__lista { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) {
    .portada { padding-block: 120px 128px; }
    .prisma { right: 8%; width: 360px; height: 420px; opacity: 1; }
    :global(.prisma__destello) { display: block; }
    .rejilla { grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .esencia__lista { grid-template-columns: repeat(6, 1fr); }
    .lineas { display: grid; grid-template-columns: repeat(5, 1fr); overflow: visible; margin-inline: 0; padding-inline: 0; }
  }
  @media (min-width: 1100px) { .rejilla { grid-template-columns: repeat(4, 1fr); } }
</style>
